// Prisma schema file — BlocoUm (Gestão de Condomínio)
// Conforme AGENTS.md e .agents/rules/data-model-e-regras-de-negocio.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums do Domínio
// -----------------------------------------------------------------------------

enum PapelUsuario {
  SINDICO
  SUBSINDICO
  CONSELHEIRO
  MORADOR
  FUNCIONARIO
}

enum TipoOcupacao {
  PROPRIETARIO
  INQUILINO
  DEPENDENTE
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum StatusCobranca {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum StatusOcorrencia {
  ABERTA
  EM_ANDAMENTO
  RESOLVIDA
  CANCELADA
}

enum StatusAssinatura {
  TRIAL
  ATIVA
  EXPIRADA
  CANCELADA
}

enum ModuloPago {
  NUCLEO
  DOCUMENTOS
}

// -----------------------------------------------------------------------------
// Autenticação (Better Auth)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  moradorPerfis      MoradorPerfil[]
  comunicadoLeituras ComunicadoLeitura[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  issuer                String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -----------------------------------------------------------------------------
// Entidades Principais do Condomínio (Multi-tenant)
// -----------------------------------------------------------------------------

model Condominio {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String?
  endereco  String
  createdAt DateTime @default(now())

  // Parâmetros configuráveis de rateio e encargos
  rateioTipo        String   @default("FRACAO_IDEAL") // FRACAO_IDEAL | IGUALITARIO
  diaVencimento     Int      @default(10)
  multaAtrasoPct    Decimal  @default(2.0)
  jurosMesPct       Decimal  @default(1.0)

  blocos       Bloco[]
  unidades     Unidade[]
  memberships  Membership[]
  categorias   LancamentoCategoria[]
  lancamentos  Lancamento[]
  comunicados  Comunicado[]
  areasComuns  AreaComum[]
  ocorrencias  Ocorrencia[]
  documentos   Documento[]
  convites     Convite[]
  assinaturas  Assinatura[]
}

model Membership {
  id           String       @id @default(cuid())
  userId       String
  condominioId String
  papel        PapelUsuario
  ativo        Boolean      @default(true)
  createdAt    DateTime     @default(now())

  condominio   Condominio   @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, condominioId])
  @@index([condominioId])
}

model Bloco {
  id           String     @id @default(cuid())
  condominioId String
  nome         String     // ex: "Bloco A", "Torre 1"

  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  unidades     Unidade[]
  comunicados  Comunicado[]

  @@index([condominioId])
}

model Unidade {
  id            String     @id @default(cuid())
  condominioId  String
  blocoId       String?
  identificador String     // ex: "Apto 101"
  fracaoIdeal   Decimal    // percentual usado no rateio (soma das unidades = 100)

  condominio    Condominio      @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  bloco         Bloco?          @relation(fields: [blocoId], references: [id], onDelete: SetNull)
  moradores     MoradorPerfil[]
  cobrancas     Cobranca[]
  reservas      Reserva[]
  ocorrencias   Ocorrencia[]
  convites      Convite[]

  @@index([condominioId])
  @@index([blocoId])
}

model MoradorPerfil {
  id           String       @id @default(cuid())
  userId       String
  unidadeId    String
  tipoOcupacao TipoOcupacao

  unidade      Unidade      @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([unidadeId])
  @@index([userId])
}

model LancamentoCategoria {
  id           String         @id @default(cuid())
  condominioId String
  nome         String         // ex: "Manutenção", "Folha de pagamento", "Taxa condominial"
  tipo         TipoLancamento

  condominio   Condominio     @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  lancamentos  Lancamento[]

  @@index([condominioId])
}

model Lancamento {
  id           String              @id @default(cuid())
  condominioId String
  categoriaId  String
  tipo         TipoLancamento
  descricao    String
  valor        Decimal
  data         DateTime

  condominio   Condominio          @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  categoria    LancamentoCategoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([condominioId])
  @@index([categoriaId])
}

model Cobranca {
  id            String         @id @default(cuid())
  unidadeId     String
  competencia   DateTime       // mês de referência (UTC)
  valorOriginal Decimal
  valorAtual    Decimal        // com multa/juros aplicados, se atrasado
  vencimento    DateTime
  status        StatusCobranca @default(PENDENTE)
  pagoEm        DateTime?

  unidade       Unidade        @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([unidadeId, competencia])
  @@index([unidadeId])
}

model Comunicado {
  id           String     @id @default(cuid())
  condominioId String
  titulo       String
  corpo        String
  blocoId      String?    // null = todos os blocos
  publicadoEm  DateTime   @default(now())

  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  bloco        Bloco?     @relation(fields: [blocoId], references: [id], onDelete: SetNull)
  leituras     ComunicadoLeitura[]

  @@index([condominioId])
  @@index([blocoId])
}

model ComunicadoLeitura {
  id           String     @id @default(cuid())
  comunicadoId String
  userId       String
  lidoEm       DateTime   @default(now())

  comunicado   Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comunicadoId, userId])
  @@index([comunicadoId])
  @@index([userId])
}

model AreaComum {
  id                 String     @id @default(cuid())
  condominioId       String
  nome               String     // ex: "Salão de festas", "Churrasqueira"
  antecedenciaMinHrs Int        @default(24)

  condominio         Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  reservas           Reserva[]

  @@index([condominioId])
}

model Reserva {
  id           String    @id @default(cuid())
  areaComumId  String
  unidadeId    String
  inicio       DateTime
  fim          DateTime
  status       String    @default("CONFIRMADA") // CONFIRMADA | CANCELADA
  criadoPor    String?   // userId

  areaComum    AreaComum @relation(fields: [areaComumId], references: [id], onDelete: Cascade)
  unidade      Unidade   @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([areaComumId])
  @@index([unidadeId])
}

model Ocorrencia {
  id           String           @id @default(cuid())
  condominioId String
  unidadeId    String?
  categoria    String
  titulo       String
  descricao    String
  status       StatusOcorrencia @default(ABERTA)
  criadoPor    String           // userId
  atribuidoA   String?          // userId
  createdAt    DateTime         @default(now())

  condominio   Condominio       @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  unidade      Unidade?         @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  comentarios  OcorrenciaComentario[]

  @@index([condominioId])
  @@index([unidadeId])
}

model OcorrenciaComentario {
  id           String     @id @default(cuid())
  ocorrenciaId String
  autorId      String     // userId
  texto        String
  createdAt    DateTime   @default(now())

  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)

  @@index([ocorrenciaId])
}

model Documento {
  id           String     @id @default(cuid())
  condominioId String
  categoria    String     // ATA | REGIMENTO | CONVENCAO | OUTRO
  titulo       String
  arquivoUrl   String
  visivelPara  String     @default("TODOS") // TODOS | CONSELHO
  createdAt    DateTime   @default(now())

  condominio   Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)

  @@index([condominioId])
}

model Convite {
  id           String       @id @default(cuid())
  condominioId String
  unidadeId    String
  tipoOcupacao TipoOcupacao @default(PROPRIETARIO)
  email        String
  token        String       @unique
  status       String       @default("PENDENTE") // PENDENTE | ACEITO | EXPIRADO
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  condominio   Condominio   @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  unidade      Unidade      @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([condominioId])
  @@index([unidadeId])
}

// -----------------------------------------------------------------------------
// Assinaturas e Pagamentos por Módulo (AbacatePay)
// Conforme .agents/rules/assinaturas-e-pagamento-por-modulo.md
// -----------------------------------------------------------------------------

model Plano {
  id                  String     @id @default(cuid())
  modulo              ModuloPago
  nome                String     // "Plano X" — nome definitivo ainda não decidido, configurável
  valorMensal         Decimal
  abacatePayLinkId    String?    // id do Link de Pagamento reutilizável criado na AbacatePay
  ativo               Boolean    @default(true)
}

model Assinatura {
  id                    String           @id @default(cuid())
  condominioId          String
  modulo                ModuloPago
  planoId               String?
  status                StatusAssinatura @default(TRIAL)
  trialInicio           DateTime?
  trialFim              DateTime?
  validaAte             DateTime?        // até quando o último pagamento cobre acesso
  abacatePayCustomerId  String?
  condominio            Condominio       @relation(fields: [condominioId], references: [id])
  pagamentos            Pagamento[]

  @@unique([condominioId, modulo])
}

model Pagamento {
  id                 String     @id @default(cuid())
  assinaturaId       String
  referenciaExterna  String     @unique // id do checkout/transparent/payment-link na AbacatePay
  metodo             String     // PIX | BOLETO | LINK_PAGAMENTO
  valor              Decimal
  status             String     // PENDENTE | PAGO | EXPIRADO | ESTORNADO
  pagoEm             DateTime?
  assinatura         Assinatura @relation(fields: [assinaturaId], references: [id])
}
